{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "types": [
            "node",
            "mocha"
        ],
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "tests/**/*.ts",
        "target/types/**/*.ts"
    ]
}