{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "types": ["mocha"],
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "tests/config-program.ts"
    ]
}